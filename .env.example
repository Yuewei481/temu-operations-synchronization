## Optional TEMU automatic login. Put real values in .env only; never commit them.
SELLER_PHONE_COUNTRY_CODE=86
SELLER_PHONE=
SELLER_PASSWORD=

SELLER_HOME_WAIT_MS=15000
SELLER_HOME_AFTER_ENTRY_MIN_WAIT_MS=120000
SELLER_HOME_AFTER_ENTRY_TIMEOUT_MS=600000
MANUAL_LOGIN_TIMEOUT_MS=1800000

HUMAN_DELAY_MIN_SECONDS=2
HUMAN_DELAY_MAX_SECONDS=5
SALES_TREND_RENDER_DELAY_MIN_SECONDS=5
SALES_TREND_RENDER_DELAY_MAX_SECONDS=7

# 1: collect sales only. 0: collect sales and traffic.
COLLECT_SALES_ONLY=1

# Choose exactly one output action for every configured account:
# 1 = create a new standalone Excel file only
# 2 = update an existing local Excel file only
# 3 = update a WPS cloud Excel file only
OUTPUT_MODE=1

# Leave blank to collect yesterday. Multiple dates are comma-separated.
TRAFFIC_TARGET_DATES=
# Traffic collection only: 昨日, 近7日, or 近30日. Leave blank for automatic selection.
TRAFFIC_DATE_RANGE=

# Start checking immediately; wait at most 30 minutes for manual WPS login and document loading.
WPS_INITIAL_WAIT_MS=0
WPS_LOGIN_TIMEOUT_MS=1800000
CLOSE_CHROME_AFTER_RUN=1

# Optional. Leave blank to detect Google Chrome automatically.
CHROME_PATH=

ACCOUNT_COUNT=2

ACCOUNT_1_NAME=TEMU 1
ACCOUNT_1_CDP_PORT=9222
ACCOUNT_1_CHROME_PROFILE=C:/seller-central-profiles/temu1
ACCOUNT_1_SELLER_PHONE_COUNTRY_CODE=
ACCOUNT_1_SELLER_PHONE=
ACCOUNT_1_SELLER_PASSWORD=
ACCOUNT_1_SOURCE_EXCEL=C:/seller-central-data/SKU SKC 品名.xlsx
ACCOUNT_1_SOURCE_EXCEL_SKU_CARGO_PRIMARY_COLUMN=A
ACCOUNT_1_SOURCE_EXCEL_SKU_CARGO_SECONDARY_COLUMN=B
ACCOUNT_1_SOURCE_EXCEL_NAME_COLUMN=C
ACCOUNT_1_SOURCE_EXCEL_IMAGE_COLUMN=
# OUTPUT_MODE=1 only. A complete output filename is required.
ACCOUNT_1_EXPORT_EXCEL_PATH=C:/seller-central-output/temu1-sales.xlsx
# OUTPUT_MODE=2 only.
ACCOUNT_1_TARGET_EXCEL_PATH=
ACCOUNT_1_TARGET_EXCEL_SHEET_NAME=运营数据记录表
ACCOUNT_1_TARGET_EXCEL_DATE_COLUMN=A
ACCOUNT_1_TARGET_EXCEL_NAME_COLUMN=B
ACCOUNT_1_TARGET_EXCEL_SALES_COLUMN=C
ACCOUNT_1_TARGET_EXCEL_START_ROW=2
# OUTPUT_MODE=2 optional daily totals. The total workbook may equal TARGET_EXCEL_PATH.
ACCOUNT_1_LOCAL_DAILY_TOTAL_ENABLED=0
ACCOUNT_1_LOCAL_TOTAL_EXCEL_PATH=
ACCOUNT_1_LOCAL_TOTAL_SHEET_NAME=总销量表
ACCOUNT_1_LOCAL_TOTAL_DATE_COLUMN=A
ACCOUNT_1_LOCAL_TOTAL_SALES_COLUMN=B
ACCOUNT_1_LOCAL_TOTAL_START_ROW=3
# Optional account-specific date override. Leave blank to inherit TRAFFIC_TARGET_DATES.
ACCOUNT_1_TRAFFIC_TARGET_DATES=
# OUTPUT_MODE=3 only.
ACCOUNT_1_WPS_DOC_URL=
ACCOUNT_1_WPS_SHEET_NAME=运营数据记录表
ACCOUNT_1_WPS_DATE_COLUMN=A
ACCOUNT_1_WPS_NAME_COLUMN=B
ACCOUNT_1_WPS_SALES_COLUMN=C
ACCOUNT_1_WPS_START_ROW=2
# Daily totals include matched lookup products only. This target may be a different WPS file/sheet.
ACCOUNT_1_WPS_DAILY_TOTAL_ENABLED=1
ACCOUNT_1_WPS_TOTAL_DOC_URL=
ACCOUNT_1_WPS_TOTAL_SHEET_NAME=总销量表
ACCOUNT_1_WPS_TOTAL_DATE_COLUMN=A
ACCOUNT_1_WPS_TOTAL_SALES_COLUMN=B
ACCOUNT_1_WPS_TOTAL_START_ROW=3

ACCOUNT_2_NAME=TEMU 2
ACCOUNT_2_CDP_PORT=9223
ACCOUNT_2_CHROME_PROFILE=C:/seller-central-profiles/temu2
ACCOUNT_2_SELLER_PHONE_COUNTRY_CODE=
ACCOUNT_2_SELLER_PHONE=
ACCOUNT_2_SELLER_PASSWORD=
ACCOUNT_2_SOURCE_EXCEL=C:/seller-central-data/SKU SKC 品名.xlsx
ACCOUNT_2_SOURCE_EXCEL_SKU_CARGO_PRIMARY_COLUMN=A
ACCOUNT_2_SOURCE_EXCEL_SKU_CARGO_SECONDARY_COLUMN=B
ACCOUNT_2_SOURCE_EXCEL_NAME_COLUMN=C
ACCOUNT_2_SOURCE_EXCEL_IMAGE_COLUMN=
# OUTPUT_MODE=1 only. A complete output filename is required.
ACCOUNT_2_EXPORT_EXCEL_PATH=C:/seller-central-output/temu2-sales.xlsx
# OUTPUT_MODE=2 only.
ACCOUNT_2_TARGET_EXCEL_PATH=
ACCOUNT_2_TARGET_EXCEL_SHEET_NAME=运营数据记录表
ACCOUNT_2_TARGET_EXCEL_DATE_COLUMN=A
ACCOUNT_2_TARGET_EXCEL_NAME_COLUMN=B
ACCOUNT_2_TARGET_EXCEL_SALES_COLUMN=C
ACCOUNT_2_TARGET_EXCEL_START_ROW=2
ACCOUNT_2_LOCAL_DAILY_TOTAL_ENABLED=0
ACCOUNT_2_LOCAL_TOTAL_EXCEL_PATH=
ACCOUNT_2_LOCAL_TOTAL_SHEET_NAME=总销量表
ACCOUNT_2_LOCAL_TOTAL_DATE_COLUMN=D
ACCOUNT_2_LOCAL_TOTAL_SALES_COLUMN=E
ACCOUNT_2_LOCAL_TOTAL_START_ROW=3
# Optional account-specific date override. Leave blank to inherit TRAFFIC_TARGET_DATES.
ACCOUNT_2_TRAFFIC_TARGET_DATES=
# OUTPUT_MODE=3 only.
ACCOUNT_2_WPS_DOC_URL=
ACCOUNT_2_WPS_SHEET_NAME=运营数据记录表
ACCOUNT_2_WPS_DATE_COLUMN=A
ACCOUNT_2_WPS_NAME_COLUMN=B
ACCOUNT_2_WPS_SALES_COLUMN=C
ACCOUNT_2_WPS_START_ROW=2
# TEMU 2 has its own daily-total destination and columns.
ACCOUNT_2_WPS_DAILY_TOTAL_ENABLED=1
ACCOUNT_2_WPS_TOTAL_DOC_URL=
ACCOUNT_2_WPS_TOTAL_SHEET_NAME=总销量表
ACCOUNT_2_WPS_TOTAL_DATE_COLUMN=D
ACCOUNT_2_WPS_TOTAL_SALES_COLUMN=E
ACCOUNT_2_WPS_TOTAL_START_ROW=3

# Optional SHEIN stage. When enabled, it starts only after every TEMU account
# and its selected output action have completed successfully.
SHEIN_ENABLED=0
SHEIN_ACCOUNT_COUNT=2
# Same three modes as OUTPUT_MODE. A per-account value can override this one.
SHEIN_OUTPUT_MODE=1
# Leave blank to collect yesterday. Multiple dates are comma-separated.
SHEIN_TARGET_DATES=
# Wait at most 30 minutes for manual SHEIN login.
SHEIN_LOGIN_TIMEOUT_MS=1800000
SHEIN_HUMAN_DELAY_MIN_SECONDS=2
SHEIN_HUMAN_DELAY_MAX_SECONDS=5
SHEIN_TREND_RENDER_DELAY_MIN_SECONDS=5
SHEIN_TREND_RENDER_DELAY_MAX_SECONDS=7
SHEIN_CLOSE_CHROME_AFTER_RUN=1

SHEIN_ACCOUNT_1_NAME=SHEIN 1
SHEIN_ACCOUNT_1_CDP_PORT=9322
SHEIN_ACCOUNT_1_CHROME_PROFILE=C:/seller-central-profiles/shein1
# This may be the same lookup workbook used by a TEMU account.
SHEIN_ACCOUNT_1_SOURCE_EXCEL=C:/seller-central-data/SKU SKC 品名.xlsx
SHEIN_ACCOUNT_1_SOURCE_EXCEL_SKU_CARGO_PRIMARY_COLUMN=A
SHEIN_ACCOUNT_1_SOURCE_EXCEL_SKU_CARGO_SECONDARY_COLUMN=B
SHEIN_ACCOUNT_1_SOURCE_EXCEL_NAME_COLUMN=C
SHEIN_ACCOUNT_1_SOURCE_EXCEL_IMAGE_COLUMN=
# Optional per-account overrides. Blank values inherit the SHEIN defaults above.
SHEIN_ACCOUNT_1_OUTPUT_MODE=
SHEIN_ACCOUNT_1_TARGET_DATES=
# Output mode 1 only. This keeps the original standalone workbook format.
SHEIN_ACCOUNT_1_EXPORT_EXCEL_PATH=C:/seller-central-output/shein1-sales.xlsx
# Output mode 2 only.
SHEIN_ACCOUNT_1_TARGET_EXCEL_PATH=
SHEIN_ACCOUNT_1_TARGET_EXCEL_SHEET_NAME=运营数据记录表
SHEIN_ACCOUNT_1_TARGET_EXCEL_DATE_COLUMN=A
SHEIN_ACCOUNT_1_TARGET_EXCEL_NAME_COLUMN=B
SHEIN_ACCOUNT_1_TARGET_EXCEL_SALES_COLUMN=C
SHEIN_ACCOUNT_1_TARGET_EXCEL_START_ROW=2
# Output mode 2 optional daily totals.
SHEIN_ACCOUNT_1_LOCAL_DAILY_TOTAL_ENABLED=0
SHEIN_ACCOUNT_1_LOCAL_TOTAL_EXCEL_PATH=
SHEIN_ACCOUNT_1_LOCAL_TOTAL_SHEET_NAME=总销量表
SHEIN_ACCOUNT_1_LOCAL_TOTAL_DATE_COLUMN=G
SHEIN_ACCOUNT_1_LOCAL_TOTAL_SALES_COLUMN=H
SHEIN_ACCOUNT_1_LOCAL_TOTAL_START_ROW=3
# Output mode 3 only.
SHEIN_ACCOUNT_1_WPS_DOC_URL=
SHEIN_ACCOUNT_1_WPS_SHEET_NAME=运营数据记录表
SHEIN_ACCOUNT_1_WPS_DATE_COLUMN=A
SHEIN_ACCOUNT_1_WPS_NAME_COLUMN=B
SHEIN_ACCOUNT_1_WPS_SALES_COLUMN=C
SHEIN_ACCOUNT_1_WPS_START_ROW=2
# SHEIN 1 daily totals. Unmatched supplier numbers are excluded.
SHEIN_ACCOUNT_1_WPS_DAILY_TOTAL_ENABLED=1
SHEIN_ACCOUNT_1_WPS_TOTAL_DOC_URL=
SHEIN_ACCOUNT_1_WPS_TOTAL_SHEET_NAME=总销量表
SHEIN_ACCOUNT_1_WPS_TOTAL_DATE_COLUMN=G
SHEIN_ACCOUNT_1_WPS_TOTAL_SALES_COLUMN=H
SHEIN_ACCOUNT_1_WPS_TOTAL_START_ROW=3

# A second SHEIN account uses an isolated Chrome profile and CDP port.
SHEIN_ACCOUNT_2_NAME=SHEIN 2
SHEIN_ACCOUNT_2_CDP_PORT=9323
SHEIN_ACCOUNT_2_CHROME_PROFILE=C:/seller-central-profiles/shein2
SHEIN_ACCOUNT_2_SOURCE_EXCEL=C:/seller-central-data/SKU SKC 品名.xlsx
SHEIN_ACCOUNT_2_SOURCE_EXCEL_SKU_CARGO_PRIMARY_COLUMN=A
SHEIN_ACCOUNT_2_SOURCE_EXCEL_SKU_CARGO_SECONDARY_COLUMN=B
SHEIN_ACCOUNT_2_SOURCE_EXCEL_NAME_COLUMN=C
SHEIN_ACCOUNT_2_SOURCE_EXCEL_IMAGE_COLUMN=
SHEIN_ACCOUNT_2_OUTPUT_MODE=
SHEIN_ACCOUNT_2_TARGET_DATES=
SHEIN_ACCOUNT_2_EXPORT_EXCEL_PATH=C:/seller-central-output/shein2-sales.xlsx
SHEIN_ACCOUNT_2_TARGET_EXCEL_PATH=
SHEIN_ACCOUNT_2_TARGET_EXCEL_SHEET_NAME=运营数据记录表
SHEIN_ACCOUNT_2_TARGET_EXCEL_DATE_COLUMN=A
SHEIN_ACCOUNT_2_TARGET_EXCEL_NAME_COLUMN=B
SHEIN_ACCOUNT_2_TARGET_EXCEL_SALES_COLUMN=C
SHEIN_ACCOUNT_2_TARGET_EXCEL_START_ROW=2
SHEIN_ACCOUNT_2_LOCAL_DAILY_TOTAL_ENABLED=0
SHEIN_ACCOUNT_2_LOCAL_TOTAL_EXCEL_PATH=
SHEIN_ACCOUNT_2_LOCAL_TOTAL_SHEET_NAME=总销量表
SHEIN_ACCOUNT_2_LOCAL_TOTAL_DATE_COLUMN=J
SHEIN_ACCOUNT_2_LOCAL_TOTAL_SALES_COLUMN=K
SHEIN_ACCOUNT_2_LOCAL_TOTAL_START_ROW=3
SHEIN_ACCOUNT_2_WPS_DOC_URL=
SHEIN_ACCOUNT_2_WPS_SHEET_NAME=运营数据记录表
SHEIN_ACCOUNT_2_WPS_DATE_COLUMN=A
SHEIN_ACCOUNT_2_WPS_NAME_COLUMN=B
SHEIN_ACCOUNT_2_WPS_SALES_COLUMN=C
SHEIN_ACCOUNT_2_WPS_START_ROW=2
SHEIN_ACCOUNT_2_WPS_DAILY_TOTAL_ENABLED=1
SHEIN_ACCOUNT_2_WPS_TOTAL_DOC_URL=
SHEIN_ACCOUNT_2_WPS_TOTAL_SHEET_NAME=总销量表
SHEIN_ACCOUNT_2_WPS_TOTAL_DATE_COLUMN=J
SHEIN_ACCOUNT_2_WPS_TOTAL_SALES_COLUMN=K
SHEIN_ACCOUNT_2_WPS_TOTAL_START_ROW=3
