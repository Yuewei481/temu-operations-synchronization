SELLER_HOME_WAIT_MS=15000
SELLER_HOME_AFTER_ENTRY_MIN_WAIT_MS=120000
SELLER_HOME_AFTER_ENTRY_TIMEOUT_MS=600000
MANUAL_LOGIN_TIMEOUT_MS=1800000

HUMAN_DELAY_MIN_SECONDS=2
HUMAN_DELAY_MAX_SECONDS=5
SALES_TREND_RENDER_DELAY_MIN_SECONDS=5
SALES_TREND_RENDER_DELAY_MAX_SECONDS=7

# 1: collect sales only. 0: collect sales and traffic.
COLLECT_SALES_ONLY=1

# Choose exactly one output action for every configured account:
# 1 = create a new standalone Excel file only
# 2 = update an existing local Excel file only
# 3 = update a WPS cloud Excel file only
OUTPUT_MODE=1

# Leave blank to collect yesterday. Multiple dates are comma-separated.
TRAFFIC_TARGET_DATES=
# Traffic collection only: 昨日, 近7日, or 近30日. Leave blank for automatic selection.
TRAFFIC_DATE_RANGE=

WPS_INITIAL_WAIT_MS=120000
WPS_OPENAPI_TIMEOUT_MS=180000
CLOSE_CHROME_AFTER_RUN=1

# Optional. Leave blank to detect Google Chrome automatically.
CHROME_PATH=

ACCOUNT_COUNT=2

ACCOUNT_1_NAME=TEMU 1
ACCOUNT_1_CDP_PORT=9222
ACCOUNT_1_CHROME_PROFILE=C:/seller-central-profiles/temu1
ACCOUNT_1_SOURCE_EXCEL=C:/seller-central-data/SKU SKC 品名.xlsx
ACCOUNT_1_SOURCE_EXCEL_SKU_CARGO_PRIMARY_COLUMN=A
ACCOUNT_1_SOURCE_EXCEL_SKU_CARGO_SECONDARY_COLUMN=B
ACCOUNT_1_SOURCE_EXCEL_NAME_COLUMN=C
ACCOUNT_1_SOURCE_EXCEL_IMAGE_COLUMN=
# OUTPUT_MODE=1 only. A complete output filename is required.
ACCOUNT_1_EXPORT_EXCEL_PATH=C:/seller-central-output/temu1-sales.xlsx
# OUTPUT_MODE=2 only.
ACCOUNT_1_TARGET_EXCEL_PATH=
ACCOUNT_1_TARGET_EXCEL_SHEET_NAME=运营数据记录表
ACCOUNT_1_TARGET_EXCEL_DATE_COLUMN=A
ACCOUNT_1_TARGET_EXCEL_NAME_COLUMN=B
ACCOUNT_1_TARGET_EXCEL_SALES_COLUMN=C
ACCOUNT_1_TARGET_EXCEL_START_ROW=2
# Optional account-specific date override. Leave blank to inherit TRAFFIC_TARGET_DATES.
ACCOUNT_1_TRAFFIC_TARGET_DATES=
# OUTPUT_MODE=3 only.
ACCOUNT_1_WPS_DOC_URL=
ACCOUNT_1_WPS_SHEET_NAME=运营数据记录表
ACCOUNT_1_WPS_DATE_COLUMN=A
ACCOUNT_1_WPS_NAME_COLUMN=B
ACCOUNT_1_WPS_SALES_COLUMN=C
ACCOUNT_1_WPS_START_ROW=2

